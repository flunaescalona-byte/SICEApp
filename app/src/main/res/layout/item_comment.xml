<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- HEADER: autor + fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#475569"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#334155"
            android:textSize="10sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- TEXTO DEL COMENTARIO -->
    <TextView
        android:id="@+id/tvComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#94a3b8"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="8dp"/>

    <!-- FOTOS INLINE -->
    <HorizontalScrollView
        android:id="@+id/scrollPhotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/photosContainer"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- ARCHIVOS -->
    <TextView
        android:id="@+id/tvAttachments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#0ea5e9"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <!-- BOTONES EDITAR / ELIMINAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnEditComment"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="✏️ Editar"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:background="@drawable/btn_outline"
            android:paddingHorizontal="12dp"
            android:visibility="gone"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnDeleteComment"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🗑️ Eliminar"
            android:textColor="#f87171"
            android:textSize="11sp"
            android:background="@drawable/btn_danger"
            android:paddingHorizontal="12dp"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
